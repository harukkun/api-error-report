{
  "manifest_version": 3,
  "name": "Network Error Report",
  "version": "0.1.0",
  "description": "DevTools 패널에서 네트워크 요청을 선택해 BE 디버깅용 에러 리포트를 생성합니다.",
  "devtools_page": "src/devtools/devtools.html",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/harukkun/api-error-report"
}
